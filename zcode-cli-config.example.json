{
  "plugins": {
    "enabledPlugins": {
      "computer-use@zcode-plugins-official": true
    }
  },
  "mcp": {
    "servers": {
      "lcu": {
        "command": "python3",
        "args": [
          "/home/excelsior/.openwork/lcu-mcp/server.py"
        ],
        "enabled": true
      }
    }
  },
  "provider": {
    "zai-coding-plan": {
      "name": "Z.ai - Coding Plan",
      "kind": "anthropic",
      "options": {
        "apiKey": "<run: mirror apiKey from ~/.zcode/v2/config.json provider builtin:zai-coding-plan>",
        "baseURL": "https://api.z.ai/api/anthropic"
      },
      "models": {
        "GLM-5.3": {
          "reasoning": {
            "enabled": true,
            "variants": [
              "low",
              "max",
              "high"
            ],
            "defaultVariant": "max"
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "zcode": {
            "modified": false,
            "priority": 99
          }
        },
        "GLM-5.3-Flash": {
          "reasoning": {
            "enabled": true,
            "variants": [
              "low",
              "max",
              "high"
            ],
            "defaultVariant": "max"
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "zcode": {
            "modified": false,
            "priority": 100
          }
        }
      }
    }
  },
  "model": "zai-coding-plan/GLM-5.3"
}